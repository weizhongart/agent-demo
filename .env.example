# 通义千问API配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置
MODEL_NAME=qwen-max
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2000

# 系统配置
SESSION_TIMEOUT=1800
MAX_CONVERSATION_ROUNDS=20
KNOWLEDGE_RETRIEVAL_THRESHOLD=0.6
MAX_CONCURRENT_SESSIONS=1000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/customer_service.log

# 外部系统配置（模拟环境）
ORDER_SYSTEM_URL=http://localhost:8001
TICKET_SYSTEM_URL=http://localhost:8002
KNOWLEDGE_BASE_URL=http://localhost:8003
